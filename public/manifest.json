{
  "manifest_version": 3,
  "name": "Tab Manager",
  "version": "0.1.0",
  "description": "A local-first Chrome new tab workspace manager for spaces, stacks, and tabs.",
  "permissions": ["storage", "tabs", "windows", "history", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "commands": {
    "open_global_search": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Tab Manager global search"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "Tab Manager"
  }
}
